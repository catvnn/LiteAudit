{
    "manifest_version": 3,
    "name": "LiteAudit",
    "version": "1.5",
    "description": "Opens the locally running LiteAudit app.",
    "action": {
        "default_popup": "popup.html"
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'; frame-src http://127.0.0.1:8501;"
    }
}

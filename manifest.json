{
    "manifest_version": 3,
    "name": "LiteAudit",
    "version": "1.6",
    "description": "Opens the locally running LiteAudit app and quarantines downloads for scanning.",
    "action": {
        "default_popup": "popup.html"
    },
    "permissions": ["downloads"],
    "background": {
        "service_worker": "background.js"
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'; frame-src http://127.0.0.1:8501;"
    }
}
